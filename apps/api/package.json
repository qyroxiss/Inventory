{
  "name": "@qi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono HTTP server — thin routes over @qi/services. Runs in Docker (cloud) and inside Electron (desktop).",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@qi/auth": "workspace:*",
    "@qi/contract": "workspace:*",
    "@qi/core": "workspace:*",
    "@qi/db": "workspace:*",
    "@qi/services": "workspace:*",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  }
}
